<div style="position: sticky; top: 60px; z-index: 1020; background-color: var(--bg-color); padding: 15px 0 10px 0; margin-top: -15px; margin-bottom: 15px;">
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
  <div>
    <div class="section-subtitle">MASTER DATA</div>
    <h1 class="page-title mb-0">Tags</h1>
  </div>
  <div class="d-flex flex-wrap gap-2 gap-sm-3 align-items-center">
    <div class="input-group">
      <span class="input-group-text bg-surface border-end-0"><i class="bi bi-search text-muted"></i></span>
      <input type="text" id="tagSearch" class="form-control border-start-0 ps-0" placeholder="Search tags...">
    </div>
  </div>
</div>
</div>

<div class="card border-0 bg-transparent bg-md-surface border-md shadow-sm-md">
  <div class="card-body p-0 bg-transparent bg-md-surface">
    <div class="table-responsive d-none d-md-block">
      <table class="table table-hover mb-0">
        <thead class="bg-surface">
          <tr>
            <th onclick="sortTable(0)" style="cursor: pointer;">Tag Name <i class="bi bi-arrow-down-up text-muted ms-1" style="font-size: 0.8em;"></i></th>
            <th onclick="sortTable(1)" style="cursor: pointer;">Usage Count <i class="bi bi-arrow-down-up text-muted ms-1" style="font-size: 0.8em;"></i></th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (tags.length === 0) { %>
            <tr><td colspan="3" class="text-center text-muted p-4">No tags found.</td></tr>
          <% } %>
          <% tags.forEach(tag => { %>
            <tr class="tag-row">
              <td class="fw-bold tag-name"><span class="badge bg-secondary badge-tag rounded-pill px-3 py-2 fw-normal" style="font-size: 0.85em;"><%= tag.name %></span></td>
              <td><%= tag.count %> task<%= tag.count !== 1 ? 's' : '' %></td>
              <td class="text-end">
                <button class="btn btn-link text-decoration-none p-0 me-3" onclick="openRenameModal('<%= tag.name.replace(/'/g, "\\'") %>')">
                  <i class="bi bi-pencil"></i>
                </button>
                <button class="btn btn-link text-decoration-none text-danger p-0" onclick="confirmDeleteTag('<%= tag.name.replace(/'/g, "\\'") %>')">
                  <i class="bi bi-trash"></i>
                </button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <!-- Mobile View -->
    <div class="d-md-none">
      <% if (tags.length === 0) { %>
        <div class="text-center text-muted p-4">No tags found.</div>
      <% } %>
      <% tags.forEach(tag => { %>
        <div class="card mb-3 tag-row shadow-sm">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h6 class="card-title mb-0 tag-name fw-bold"><span class="badge bg-secondary badge-tag rounded-pill px-3 py-2 fw-normal"><%= tag.name %></span></h6>
              <div class="dropdown">
                <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown">
                  <i class="bi bi-three-dots-vertical"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                  <li><button class="dropdown-item" onclick="openRenameModal('<%= tag.name.replace(/'/g, "\\'") %>')"><i class="bi bi-pencil me-2"></i>Rename</button></li>
                  <li><button class="dropdown-item text-danger" onclick="confirmDeleteTag('<%= tag.name.replace(/'/g, "\\'") %>')"><i class="bi bi-trash me-2"></i>Delete</button></li>
                </ul>
              </div>
            </div>
            <div class="text-muted small">
              <%= tag.count %> task<%= tag.count !== 1 ? 's' : '' %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- Rename Tag Modal -->
<div class="modal fade" id="renameTagModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold">Rename Tag</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="renameTagForm" onsubmit="handleRenameTag(event)">
          <input type="hidden" id="oldTagName" name="oldTag">
          <div class="mb-3">
            <label class="form-label text-muted small fw-bold text-uppercase">Current Name</label>
            <input type="text" id="displayOldTagName" class="form-control bg-light" disabled>
          </div>
          <div class="mb-4">
            <label class="form-label text-muted small fw-bold text-uppercase">New Name</label>
            <input type="text" class="form-control" id="newTagName" name="newTag" required>
          </div>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary" id="btnRenameTag">Rename Tag</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('tagSearch').addEventListener('input', function(e) {
  const term = e.target.value.toLowerCase();
  document.querySelectorAll('.tag-row').forEach(row => {
    const name = row.querySelector('.tag-name').textContent.toLowerCase();
    row.style.display = name.includes(term) ? '' : 'none';
  });
});

let sortDirection = 1;
function sortTable(n) {
  const table = document.querySelector(".table tbody");
  if (!table) return;
  const rows = Array.from(table.querySelectorAll("tr"));
  
  rows.sort((a, b) => {
    let valA = a.querySelectorAll("td")[n]?.innerText.toLowerCase() || '';
    let valB = b.querySelectorAll("td")[n]?.innerText.toLowerCase() || '';
    
    if (n === 1) { // Usage count
      valA = parseInt(valA.split(' ')[0]) || 0;
      valB = parseInt(valB.split(' ')[0]) || 0;
      return (valA - valB) * sortDirection;
    }
    return valA.localeCompare(valB) * sortDirection;
  });
  
  sortDirection *= -1;
  rows.forEach(row => table.appendChild(row));
}

let renameModal;
document.addEventListener("DOMContentLoaded", () => {
  renameModal = new bootstrap.Modal(document.getElementById('renameTagModal'));
});

function openRenameModal(tag) {
  document.getElementById('oldTagName').value = tag;
  document.getElementById('displayOldTagName').value = tag;
  document.getElementById('newTagName').value = tag;
  renameModal.show();
}

async function handleRenameTag(e) {
  e.preventDefault();
  const oldTag = document.getElementById('oldTagName').value;
  const newTag = document.getElementById('newTagName').value.trim();
  const btn = document.getElementById('btnRenameTag');
  
  if (!newTag || oldTag === newTag) {
    renameModal.hide();
    return;
  }
  
  btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Renaming...';
  btn.disabled = true;
  
  try {
    const res = await fetch('/api/tags/rename', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ oldTag, newTag })
    });
    
    if (res.ok) {
      window.location.reload();
    } else {
      alert('Error renaming tag');
      btn.innerHTML = 'Rename Tag';
      btn.disabled = false;
    }
  } catch (err) {
    console.error(err);
    alert('Error renaming tag');
    btn.innerHTML = 'Rename Tag';
    btn.disabled = false;
  }
}

async function confirmDeleteTag(tag) {
  if (confirm(`Are you sure you want to delete the tag "${tag}"? It will be removed from all tasks.`)) {
    try {
      const res = await fetch(`/api/tags/${encodeURIComponent(tag)}`, {
        method: 'DELETE'
      });
      if (res.ok) {
        window.location.reload();
      } else {
        alert('Error deleting tag');
      }
    } catch (err) {
      console.error(err);
      alert('Error deleting tag');
    }
  }
}
</script>
