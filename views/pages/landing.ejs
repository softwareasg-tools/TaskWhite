<script>
  document.addEventListener('DOMContentLoaded', () => {
    const pricingToggle = document.getElementById('pricingToggle');
    const priceVals = document.querySelectorAll('.price-val');
    const savingsVals = document.querySelectorAll('.savings-val');
    const currencySymbols = document.querySelectorAll('.currency-symbol');
    const monthlyLabel = document.getElementById('monthlyLabel');
    const annualLabel = document.getElementById('annualLabel');
    const usdLabel = document.getElementById('usdLabel');
    const inrLabel = document.getElementById('inrLabel');
    let isInr = true;

    function updatePricing() {
      const isAnnual = pricingToggle ? pricingToggle.checked : true;

      // Update Labels
      if (isAnnual) {
        monthlyLabel.style.opacity = '0.5';
        annualLabel.style.opacity = '1';
      } else {
        annualLabel.style.opacity = '0.5';
        monthlyLabel.style.opacity = '1';
      }

      if (isInr) {
        usdLabel.style.opacity = '0.5';
        usdLabel.classList.remove('fw-bold');
        inrLabel.style.opacity = '1';
        inrLabel.classList.add('fw-bold');
        currencySymbols.forEach(el => el.innerText = '₹');
      } else {
        inrLabel.style.opacity = '0.5';
        inrLabel.classList.remove('fw-bold');
        usdLabel.style.opacity = '1';
        usdLabel.classList.add('fw-bold');
        currencySymbols.forEach(el => el.innerText = '$');
      }

      // Update Prices
      priceVals.forEach(el => {
        if (isInr) {
          el.innerText = isAnnual ? el.getAttribute('data-annual') : el.getAttribute('data-monthly');
        } else {
          el.innerText = isAnnual ? el.getAttribute('data-annual-usd') : el.getAttribute('data-monthly-usd');
        }
      });
      
      // Update Savings
      savingsVals.forEach(el => {
        el.innerText = isInr ? el.getAttribute('data-inr') : el.getAttribute('data-usd');
      });

      // Toggle Savings Visibility
      const annualSavings = document.querySelectorAll('.annual-savings');
      annualSavings.forEach(el => {
        el.style.visibility = isAnnual ? 'visible' : 'hidden';
      });
    }

    if (pricingToggle) {
      pricingToggle.addEventListener('change', updatePricing);
    }
    
    if (inrLabel && usdLabel) {
      inrLabel.addEventListener('click', () => {
        if (!isInr) {
          isInr = true;
          updatePricing();
        }
      });
      usdLabel.addEventListener('click', () => {
        if (isInr) {
          isInr = false;
          updatePricing();
        }
      });
    }
    
    // Initial call
    updatePricing();
  });
</script>
